# Plantilla de desarrollo local. Copia a .env y NO subas el .env al repositorio.
# En cualquier despliegue real DEBES cambiar SECRET_KEY y ADMIN_PASSWORD
# (y poner COOKIE_SECURE=true detrás de HTTPS).
DATABASE_URL=postgresql+psycopg://turnos:turnos@localhost:5433/turnos
TEST_DATABASE_URL=postgresql+psycopg://turnos:turnos@localhost:5433/turnos_test
# Genera una clave aleatoria de al menos 32 caracteres (la API no arranca con este placeholder):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
APP_TIMEZONE=America/Bogota
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true en producción (HTTPS); false solo para desarrollo local en http.
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Turnos <no-reply@turnos.local>
SMTP_STARTTLS=false
# Primer admin creado por el script seed (valores de ejemplo: cámbialos).
ADMIN_EMAIL=admin@turnos.local
ADMIN_PASSWORD=change-me-admin-password
MIN_NOTICE_MINUTES=60
BOOKING_HORIZON_DAYS=60
CANCEL_MIN_HOURS=2
MAX_ACTIVE_BOOKINGS_PER_CUSTOMER=5
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_TIMEZONE=America/Bogota
